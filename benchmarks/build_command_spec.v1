BUILD_COMMAND_SPEC=1
NAME=mok-sm90-make-v1
# The production build command, as an argv array (one element per ARGV line),
# and the output it must produce. Both are TRACKED and read from the commit
# being built - the wrapper takes no command from the caller in production
# mode, so there is no argv file outside the repository to swap.
#
# Every Make variable the build depends on is pinned here rather than
# inherited: an inherited SRC, OUT, NVCC, PYTHON, THUNDERKITTENS_ROOT or ARCH
# would let the environment change what gets compiled while the record still
# claimed this command.
#
# OUTPUT is the path the build must create. It is relative to the repository
# root, must stay inside it, and the wrapper refuses a symlink there.
OUTPUT=mok/_C.cpython-312-x86_64-linux-gnu.so
ARGV=make
ARGV=-f
ARGV=Makefile
ARGV=ARCH=SM90
ARGV=SRC=csrc/bindings.cu
ARGV=THUNDERKITTENS_ROOT=./third_party/ThunderKittens
ARGV=NVCC=nvcc
ARGV=PYTHON=python3
ARGV=OUT=mok/_C.cpython-312-x86_64-linux-gnu.so
# Tools whose versions MUST be probed successfully; a probe failure means the
# record cannot describe the toolchain and nothing is published. Each line is
# label|argv0|argv1|... - pipe-delimited so an argument containing spaces or
# semicolons stays one element and no shell is involved. The labels are fixed:
# nvcc, cc, python, torch (torch prints the torch version then the CUDA
# version). These are the tools this command actually uses, not a generic set.
PROBE=nvcc|nvcc|--version
PROBE=cc|cc|--version
PROBE=python|python3|--version
PROBE=torch|python3|-c|import torch; print(torch.__version__); print(torch.version.cuda)
